{
    "manifest_version": 3,
    "name": "Volume Scroll",
    "version": "3.10.1",
    "description": "Scrollable volume for any video on the internet",
    "homepage_url": "https://github.com/FredrikWilhelmsen/Volume-Scroll/",
    "permissions": ["storage", "activeTab", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "windows"],
    "host_permissions": ["<all_urls>"],
    "icons": {
        "128": "images/128.png"
    },
    "action": {
        "default_icon": "images/128.png",
        "default_title": "Volume Scroll",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "volumeScrollBackground.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["https://extensionpay.com/*"],
            "js": ["./extpayContent.ts"],
            "run_at": "document_start"
        },
        {
            "matches": ["<all_urls>"],
            "all_frames": true,
            "run_at": "document_start",
            "js": ["volumeScroll.tsx"]
        },
        {
            "matches": ["<all_urls>"],
            "all_frames": true,
            "run_at": "document_start",
            "js": ["interceptor.ts"],
            "world": "MAIN"
        }
    ]
}
